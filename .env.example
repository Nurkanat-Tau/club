# Leave DATABASE_URL empty to run locally without a database (in-memory, resets on restart).

# Postgres connection string. On Vercel: Storage → Create Database (Neon / Postgres) fills this in for you.
DATABASE_URL=

# Random string, at least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated emails that are ALLOWED to become admin (they sign up by creating a club)
ADMIN_EMAILS=

# Secret code (12+ characters) an allowed email must enter once at /admin/claim to become admin.
# Generate: openssl rand -base64 18
ADMIN_SETUP_CODE=

# Public address of the site, used in link previews and the sitemap
NEXT_PUBLIC_SITE_URL=https://club-rho-six.vercel.app

# Optional: your WhatsApp number for the "Написать нам" button, e.g. +77011234567
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Set to 1 ONLY for a public test deployment without a database (data resets).
ALLOW_DEMO=
