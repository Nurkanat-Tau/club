# Leave SUPABASE_* empty to run in DEMO MODE (in-memory data, demo logins).

# Supabase → Project Settings → API
SUPABASE_URL=
# "service_role" / secret key. SERVER ONLY. Never expose it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random string, at least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated emails that can open /admin (must also exist in the organizers table)
ADMIN_EMAILS=

# Optional: your WhatsApp number for the "Хотите свой клуб?" button, e.g. +77011234567
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Set to 1 ONLY for a public demo without a database (data resets, demo logins work).
ALLOW_DEMO=
